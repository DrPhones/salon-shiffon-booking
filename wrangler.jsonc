{
  // Static site on Cloudflare Workers (assets only, no Worker script).
  // The Worker name must match the name chosen in the Cloudflare dashboard.
  "name": "chiffon9",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./"
  },
  // Custom domains are declared here so every deploy keeps them attached.
  "routes": [
    { "pattern": "chiffon9.com", "custom_domain": true },
    { "pattern": "www.chiffon9.com", "custom_domain": true }
  ],
  // Serve only on chiffon9.com: no workers.dev URL, no preview URLs.
  "workers_dev": false,
  "preview_urls": false
}
